generator client {
  provider = "prisma-client"
  output   = "../src/server/generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String         @id @default(uuid())
  displayName String?
  active      Boolean        @default(true)
  timeZone    String?
  settingsRevision Int     @default(0)
  identities  AuthIdentity[]
  memberships Membership[]
  sessions    Session[]
  settings    UserSettings?
  issuedInvitations   Invitation[] @relation("InvitationIssuer")
  consumedInvitations Invitation[] @relation("InvitationConsumer")
}

model AuthIdentity {
  issuer  String
  subject String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([issuer, subject])
}

model Household {
  id              String       @id @default(uuid())
  singleton       Int          @unique @default(1)
  defaultTimeZone String       @default("Asia/Seoul")
  settingsRevision Int        @default(0)
  memberships     Membership[]
  reminders       Reminder[]
  settings        HouseholdSettings?
  invitations     Invitation[]
  audit           HouseholdAudit[]
}

model Membership {
  householdId String
  userId      String
  role        String
  active      Boolean      @default(true)
  revision    Int          @default(0)
  joinedAt    DateTime?
  leftAt      DateTime?
  removedByUserId String?
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  created     Reminder[]   @relation("ReminderCreator")
  requested   Reminder[]   @relation("ReminderRequester")
  assigned    Assignment[]
  @@id([householdId, userId])
  @@index([householdId, active, role])
}

model Invitation {
  id               String    @id @default(uuid())
  householdId      String
  createdByUserId  String
  targetEmail      String?
  tokenHash        String    @unique
  createdAt        DateTime
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedByUserId String?
  revokedAt        DateTime?
  household        Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  createdBy        User      @relation("InvitationIssuer", fields: [createdByUserId], references: [id], onDelete: Restrict)
  consumedBy       User?     @relation("InvitationConsumer", fields: [consumedByUserId], references: [id], onDelete: Restrict)
  @@index([householdId, createdAt, id])
  @@index([expiresAt, id])
}

model HouseholdSettings {
  householdId              String    @id
  schemaVersion            Int       @default(1)
  minRadiusM               Int       @default(50)
  defaultRadiusM           Int       @default(100)
  maxRadiusM               Int       @default(500)
  maxLocationDurationMin   Int       @default(60)
  weeklyCalendarConvention String    @default("MONDAY_START")
  household                Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
}

model UserSettings {
  userId        String @id
  schemaVersion Int    @default(1)
  locale        String?
  user          User   @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model HouseholdAudit {
  id          String    @id @default(uuid())
  householdId String
  actorId     String
  action      String
  subjectId   String
  createdAt   DateTime
  details     String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  @@index([householdId, createdAt, id])
}

model HouseholdCommandResult {
  scope       String
  key         String
  inputSalt   String
  inputDigest String
  result      String
  @@id([scope, key])
}

model LoginChallenge {
  digest     String   @id
  nonce      String   @unique
  issuedAt   DateTime
  expiresAt  DateTime
  consumedAt DateTime?
  @@index([expiresAt])
}

model LoginProof {
  issuer    String
  subject   String
  authTime  Int
  expiresAt DateTime
  @@id([issuer, subject, authTime])
  @@index([expiresAt])
}

model Session {
  digest    String    @id
  userId    String
  issuer    String
  subject   String
  authTime  Int
  expiresAt DateTime
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([expiresAt])
}

model Reminder {
  id            String     @id @default(uuid())
  householdId   String
  title         String
  description   String?
  createdBy     String
  requesterId   String
  revision      Int        @default(1)
  lifecycle     String     @default("ACTIVE")
  archivedAt    DateTime?
  verificationEnabled Boolean @default(false)
  verifierUserId String?
  pausedAt      DateTime?
  createdAt     DateTime   @default(now())
  household     Household  @relation(fields: [householdId], references: [id], onDelete: Restrict)
  creator       Membership @relation("ReminderCreator", fields: [householdId, createdBy], references: [householdId, userId], onDelete: Restrict)
  requester     Membership @relation("ReminderRequester", fields: [householdId, requesterId], references: [householdId, userId], onDelete: Restrict)
  assignments   Assignment[]
  trigger       Trigger?
  occurrences   Occurrence[]
  recurrenceRules RecurrenceRule[]
  workAudit     ReminderAudit[]
  commandResults ReminderCommandResult[]
  requestResults RequestResult[]
  @@unique([id, householdId])
  @@index([householdId, createdAt, id])
  @@index([householdId, requesterId])
  @@index([householdId, lifecycle, archivedAt, id])
}

model Assignment {
  id          String @id @default(uuid())
  householdId String
  reminderId  String
  userId      String
  endedAt     DateTime?
  assignedAt  DateTime?
  reminder    Reminder   @relation(fields: [reminderId, householdId], references: [id, householdId], onDelete: Cascade)
  assignee    Membership @relation(fields: [householdId, userId], references: [householdId, userId], onDelete: Restrict)
  @@index([reminderId, userId, endedAt])
  @@index([householdId, userId])
}

model Trigger {
  reminderId  String   @id
  kind        String   @default("TIME")
  scheduledAt DateTime?
  timeZone    String?
  latitude    Float?
  longitude   Float?
  placeName   String?
  radiusM     Int?
  event       String?
  durationMin Int?
  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
}

model Occurrence {
  id          String   @id @default(uuid())
  reminderId  String
  occurrenceKey String @default("initial")
  recurrenceRuleId String?
  state       String   @default("PENDING")
  scheduledAt DateTime?
  stateAt     DateTime @default(now())
  reason      String?
  revision    Int      @default(1)
  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  override    OccurrenceOverride?
  completions Completion[]
  @@unique([reminderId, occurrenceKey])
  @@index([reminderId, state, scheduledAt, id])
  @@index([reminderId, state, stateAt, id])
}

model RecurrenceRule {
  id            String @id @default(uuid())
  reminderId    String
  effectiveFrom String
  effectiveTo   String?
  definition    String
  generatedThrough String?
  reminder      Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  occurrences   Occurrence[]
  @@index([reminderId, effectiveFrom])
}

model OccurrenceOverride {
  occurrenceId String @id
  patch        String
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
}

model Completion {
  id            String @id @default(uuid())
  occurrenceId  String
  submittedBy   String
  verifierUserId String?
  state         String
  requestedAt   DateTime
  respondedAt   DateTime?
  responseActorId String?
  reason        String?
  occurrence    Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  @@index([occurrenceId, requestedAt, id])
  @@index([verifierUserId, state])
}

model ReminderAudit {
  id            String @id @default(uuid())
  householdId   String
  reminderId    String
  occurrenceId  String?
  actorId       String
  action        String
  stateAt       DateTime
  changes       String
  reminder      Reminder @relation(fields: [reminderId, householdId], references: [id, householdId], onDelete: Cascade)
  @@index([householdId, stateAt, id])
  @@index([reminderId, stateAt, id])
}

model ReminderCommandResult {
  householdId  String
  actorId      String
  operation    String
  key          String
  digest       String
  reminderId   String
  result       String
  reminder     Reminder @relation(fields: [reminderId, householdId], references: [id, householdId], onDelete: Cascade)
  @@id([householdId, actorId, operation, key])
  @@index([reminderId])
}

model HouseholdFeedCursor {
  householdId String @id
  revision    Int    @default(0)
}

model ReminderFeedEntry {
  householdId String
  revision    Int
  reminderId  String
  kind        String
  changedAt   DateTime
  expiresAt   DateTime?
  @@id([householdId, revision])
  @@index([expiresAt])
  @@index([householdId, reminderId])
}

model DeletionCommit {
  requestId   String @id
  householdId String
  reminderId  String
  revision    Int
  committedAt DateTime
  inputDigest String?
  @@index([householdId, reminderId])
}

model DeletedCreateKey {
  scopeDigest String
  format      String
  inputDigest String
  @@id([scopeDigest, format])
}

model RecoveryJournalIdentity {
  id    Int @id
  token String
}

model RequestResult {
  householdId String
  userId      String
  operation   String
  key         String
  inputDigest String
  reminderId  String
  reminder    Reminder @relation(fields: [reminderId, householdId], references: [id, householdId], onDelete: Cascade)
  @@id([householdId, userId, operation, key])
}
