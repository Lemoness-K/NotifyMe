{
  "name": "notify-me",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "build": "npm run generate && tsc -p tsconfig.build.json && vite build",
    "typecheck": "npm run generate && tsc --noEmit",
    "start": "node dist/server/main.js",
    "admin:bootstrap": "node dist/server/bootstrap-admin.js",
    "operations": "node dist/server/operations-cli.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:android:jvm": "./android/gradlew -p android/schedule-core test",
    "verify:u1": "npm run typecheck && npm run build && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.18.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^31.0.1",
    "prisma": "7.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "4.1.12"
  }
}
