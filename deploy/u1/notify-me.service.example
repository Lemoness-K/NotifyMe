[Unit]
Description=Notify Me
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notify-me
Group=notify-me
WorkingDirectory=/opt/notify-me
EnvironmentFile=/etc/notify-me/runtime.env
ExecStart=/usr/bin/node /opt/notify-me/dist/server/main.js
Restart=on-failure
StateDirectory=notify-me
StateDirectoryMode=0700
Environment=NOTIFY_DELETE_JOURNAL_PATH=/var/lib/notify-me/delete-journal.sqlite
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
