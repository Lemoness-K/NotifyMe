[Unit]
Description=Create and retain a Notify Me SQLite backup
After=notify-me.service

[Service]
Type=oneshot
User=notify-me
Group=notify-me
WorkingDirectory=/opt/notify-me
EnvironmentFile=/etc/notify-me/operations.env
ExecStart=/usr/bin/node /opt/notify-me/dist/server/operations-cli.js backup
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
