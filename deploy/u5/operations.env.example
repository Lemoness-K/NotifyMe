NOTIFY_DATABASE_PATH=/var/lib/notify-me/notify.sqlite
NOTIFY_DELETE_JOURNAL_PATH=/var/lib/notify-me/delete-journal.sqlite
NOTIFY_OPS_STATE_DIRECTORY=/var/lib/notify-me
NOTIFY_OPS_ARCHIVES=/var/lib/notify-backups
NOTIFY_OPS_AUTHORITY_MOUNT=/mnt/notify-authority
# Set this to the identifier in the mount's notify-me-volume file.
NOTIFY_OPS_VOLUME_ID=
NOTIFY_OPS_KEY_FILE=/etc/notify-me/backup-key
NOTIFY_OPS_AUTHORITY_KEY_FILE=/etc/notify-me/authority-key
NOTIFY_OPS_TIME_ZONE=Asia/Seoul
NOTIFY_OPS_WEEKLY=0
NOTIFY_OPS_INCIDENTS=0
# Enable only for a prepared installation reached exclusively by tailnet operators.
# NOTIFY_SETUP_INGRESS=tailnet-operator-only
